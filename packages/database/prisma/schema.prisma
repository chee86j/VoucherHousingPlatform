// VoucherHousingPlatform - Phase 1 Schema
// Foundation: Organization, User, AuditLog
// 
// Design principles from docs/ARCHITECTURE_DISCOVERY.md:
// - org_id on every table from day one (§7)
// - PII columns marked for application-layer encryption (§7)
// - Append-only audit log with hash chaining (§7, §10 R6)
// - Server-enforced authorization, never client-side gating (§9)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Organization - Multi-tenancy foundation
// ============================================================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  type      OrgType  @default(BROKER)
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  users     User[]
  auditLogs AuditLog[]
  clients   Client[]
  landlords Landlord[]
  utilityAllowanceSchedules UtilityAllowanceSchedule[]
  cases Case[]
  showingSessions ShowingSession[]
  followUpTasks FollowUpTask[]

  @@map("organizations")
}

enum OrgType {
  BROKER      // Brokerage firm
  NONPROFIT   // Housing nonprofit
  AGENCY      // Government agency (future)
  PLATFORM    // Platform admin org
}

// ============================================================================
// User - Identity with role-based access
// ============================================================================

model User {
  id             String     @id @default(cuid())
  orgId          String     @map("org_id")
  
  // PII fields - marked for application-layer encryption
  // @encrypted annotation is a reminder; actual encryption in application layer
  email          String     @unique // @encrypted
  emailVerified  DateTime?  @map("email_verified")
  phone          String?    // @encrypted
  name           String     // @encrypted
  
  // Auth
  passwordHash   String?    @map("password_hash")
  role           UserRole   @default(TENANT)
  status         UserStatus @default(PENDING)
  
  // MFA - mandatory for staff who can read documents (§7)
  mfaEnrolled    Boolean    @default(false) @map("mfa_enrolled")
  mfaSecret      String?    @map("mfa_secret") // @encrypted
  
  // Metadata
  lastLoginAt    DateTime?  @map("last_login_at")
  lastLoginIp    String?    @map("last_login_ip")
  failedAttempts Int        @default(0) @map("failed_attempts")
  lockedUntil    DateTime?  @map("locked_until")
  deactivatedAt  DateTime?  @map("deactivated_at")
  deactivatedBy  String?    @map("deactivated_by")
  
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  
  // Relations
  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  auditLogs      AuditLog[]   @relation("AuditLogActor")
  
  // Sessions (Redis-backed, but we track metadata)
  sessions       Session[]
  ownedCases     Case[] @relation("CaseOwner")
  caseEvents     CaseStageHistory[] @relation("CaseActor")
  showingEvents ShowingEvent[] @relation("ShowingEventActor")
  showingTasks FollowUpTask[] @relation("TaskOwner")
  createdShowingTasks FollowUpTask[] @relation("TaskCreator")
  
  @@index([orgId])
  @@index([email])
  @@index([status])
  @@map("users")
}

enum UserRole {
  ADMIN      // Platform admin, org owner
  BROKER     // V1 power user - manages client book and showings
  ASSISTANT  // Helps broker with intake, confirmations, follow-up
  LANDLORD   // Property owner - sees redacted applicant info
  TENANT     // Head of household - sees own case only
  AUDITOR    // Read-only compliance access
}

enum UserStatus {
  PENDING     // Awaiting email verification
  ACTIVE      // Normal access
  SUSPENDED   // Temporarily blocked
  DEACTIVATED // Permanently disabled
}

// ============================================================================
// Session - Server-side session tracking
// ============================================================================

model Session {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  
  // Session metadata
  token         String   @unique // Session token (hashed)
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  
  // Lifecycle
  createdAt     DateTime @default(now()) @map("created_at")
  lastActivityAt DateTime @default(now()) @map("last_activity_at")
  expiresAt     DateTime @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?  @map("revoked_reason")
  
  // Relations
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

// ============================================================================
// AuditLog - Append-only, hash-chained (§7, §10 R6)
// ============================================================================

// CRITICAL: The application database role must have INSERT-only permissions
// on this table. No UPDATE or DELETE grants. Hash chaining ensures tampering
// is detectable. This is verified in the pre-pilot compliance gate.

model AuditLog {
  id           String      @id @default(cuid())
  orgId        String      @map("org_id")
  
  // Actor information
  actorUserId  String?     @map("actor_user_id")
  actorIp      String?     @map("actor_ip")
  actorUserAgent String?   @map("actor_user_agent")
  
  // Action details
  action       AuditAction
  resourceType String      @map("resource_type")
  resourceId   String?     @map("resource_id")
  
  // State change tracking
  beforeState  Json?       @map("before_state")
  afterState   Json?       @map("after_state")
  
  // Override tracking (§9 rule 3)
  reason       String?     // Required for overrides
  severity     AuditSeverity @default(NORMAL)
  
  // Hash chaining for tamper detection
  prevHash     String?     @map("prev_hash")
  hash         String      // SHA-256 of (id, action, resourceType, resourceId, actorUserId, timestamp, prevHash)
  
  // Timestamp
  occurredAt   DateTime    @default(now()) @map("occurred_at")
  
  // Relations
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  actor        User?        @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  
  @@index([orgId])
  @@index([actorUserId])
  @@index([resourceType, resourceId])
  @@index([occurredAt])
  @@index([action])
  @@map("audit_logs")
}

enum AuditAction {
  // Auth
  LOGIN
  LOGOUT
  LOGIN_FAILED
  MFA_ENROLLED
  MFA_VERIFIED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  
  // CRUD
  CREATE
  READ
  UPDATE
  DELETE
  
  // Documents (§7 - every read audited)
  DOCUMENT_UPLOAD
  DOCUMENT_VIEW
  DOCUMENT_DOWNLOAD
  SIGNED_URL_MINTED
  
  // Workflow (§9)
  STAGE_TRANSITION
  OVERRIDE
  OWNER_CHANGE
  STALL_FLAGGED
  
  // Showing operations
  SHOWING_CREATED
  SHOWING_UPDATED
  INVITE_SENT
  INVITE_RESPONDED
  STATUS_CHANGED
  
  // Match operations
  MATCH_SCORED
  SHORTLIST_UPDATED
  PRIORITY_CHANGED
  NOT_A_FIT_MARKED
  
  // Admin
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  ROLE_CHANGED
  PERMISSION_GRANTED
  PERMISSION_REVOKED
  
  // Export and access
  EXPORT
  BULK_READ
  
  // System
  SESSION_CREATED
  SESSION_REVOKED
  SYSTEM_ERROR
}

enum AuditSeverity {
  LOW       // Routine operations
  NORMAL    // Standard operations
  ELEVATED  // Override operations, manual interventions
  HIGH      // Security-relevant, permission changes
  CRITICAL  // Potential security incidents
}

// ============================================================================
// Phase 2: Core Entities (§8 Data Model)
// ============================================================================

// ============================================================================
// Client - Voucher holder household (§8)
// ============================================================================

model Client {
  id                String       @id @default(cuid())
  orgId             String       @map("org_id")
  
  // Primary contact (may have User account later)
  primaryUserId     String?      @map("primary_user_id")
  
  // PII - application-layer encrypted
  legalName         String       @map("legal_name") // @encrypted
  phone             String?      // @encrypted
  email             String?      // @encrypted
  
  // Operational
  preferredLanguage String?      @map("preferred_language")
  currentHousingStatus String?   @map("current_housing_status") // shelter, doubled-up, housed
  
  // Pipeline stage (UI_UX_DESIGN.md §2.2)
  pipelineStage     ClientPipelineStage @default(NEW_LEAD) @map("pipeline_stage")
  
  // Broker notes (internal only)
  notes             String?
  
  // Assignment
  assignedBrokerId  String?      @map("assigned_broker_id")
  
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  
  // Relations
  organization      Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  householdMembers  HouseholdMember[]
  vouchers          Voucher[]
  cases             Case[]
  showingParticipants ShowingParticipant[]
  
  @@index([orgId])
  @@index([pipelineStage])
  @@index([assignedBrokerId])
  @@map("clients")
}

enum ClientPipelineStage {
  NEW_LEAD
  INTAKE_INCOMPLETE
  DOCUMENTS_NEEDED
  READY_TO_MATCH
  MATCHED_TO_PROPERTY
  SHOWING_SCHEDULED
  INTERESTED
  APPLICATION_SUBMITTED
  APPROVED_LEASED
  INACTIVE_LOST
}

// ============================================================================
// HouseholdMember - People in the voucher household (§8)
// ============================================================================

model HouseholdMember {
  id           String   @id @default(cuid())
  clientId     String   @map("client_id")
  
  // PII - application-layer encrypted
  name         String   // @encrypted
  dob          DateTime? // @encrypted - date of birth
  relationship String   // head_of_household, spouse, child, other
  
  isMinor      Boolean  @default(false) @map("is_minor")
  incomeContributor Boolean @default(false) @map("income_contributor")
  
  addedAt      DateTime @default(now()) @map("added_at")
  removedAt    DateTime? @map("removed_at") // Soft delete - household changes affect voucher
  
  // Relations
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  @@index([clientId])
  @@map("household_members")
}

// ============================================================================
// Voucher - Rental assistance voucher (§8)
// ============================================================================

model Voucher {
  id                    String              @id @default(cuid())
  clientId              String              @map("client_id")
  
  // Program - SENSITIVE: HASA implies health status, never expose to landlord
  program               VoucherProgram
  issuanceType          IssuanceType        @default(NEW) @map("issuance_type")
  status                VoucherStatus       @default(PENDING)
  
  // Verification
  verificationState     VoucherVerificationState @default(UNVERIFIED) @map("verification_state")
  verifiedBy            String?             @map("verified_by")
  verifiedAt            DateTime?           @map("verified_at")
  
  // Economics
  bedroomsApproved      Int                 @map("bedrooms_approved")
  maxRentCents          Int                 @map("max_rent_cents")
  tenantPortionCents    Int?                @map("tenant_portion_cents")
  utilityResponsibility Json?               @map("utility_responsibility") // {heat, hot_water, electric, gas}
  
  // Dates
  issueDate             DateTime?           @map("issue_date")
  expiryDate            DateTime?           @map("expiry_date")
  recertificationDueDate DateTime?          @map("recertification_due_date")
  
  // Agency reference
  agencyCaseRef         String?             @map("agency_case_ref") // @encrypted
  
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  
  // Relations
  client                Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  cases                 Case[]
  fitEvaluations        FitEvaluation[]
  
  @@index([clientId])
  @@index([program])
  @@index([status])
  @@index([expiryDate])
  @@map("vouchers")
}

enum VoucherProgram {
  CITYFHEPS
  FHEPS
  SECTION8
  HASA      // Health-adjacent - implies HIV status
  OTHER
}

enum IssuanceType {
  NEW
  TRANSFER
}

enum VoucherStatus {
  PENDING
  ACTIVE
  EXPIRED
  SUSPENDED
  UNKNOWN
}

enum VoucherVerificationState {
  UNVERIFIED
  SELF_REPORTED
  DOC_VERIFIED
  AGENCY_CONFIRMED
}

// ============================================================================
// Landlord - Property owner (§8)
// ============================================================================

model Landlord {
  id                  String   @id @default(cuid())
  orgId               String   @map("org_id")
  
  // PII
  legalEntityName     String   @map("legal_entity_name")
  contactName         String?  @map("contact_name") // @encrypted
  phone               String?  // @encrypted
  email               String?  // @encrypted
  
  // Onboarding
  programExperienceLevel String? @map("program_experience_level") // new, experienced, veteran
  onboardingState     String?  @map("onboarding_state")
  bankingVerified     Boolean  @default(false) @map("banking_verified")
  
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  
  // Relations
  organization        Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  properties          Property[]
  
  @@index([orgId])
  @@map("landlords")
}

// ============================================================================
// Property - Building with units (§8)
// ============================================================================

model Property {
  id                String   @id @default(cuid())
  landlordId        String   @map("landlord_id")
  
  // Address
  addressLine1      String   @map("address_line_1")
  city              String   @default("New York")
  state             String   @default("NY")
  zip               String
  borough           String?  // Manhattan, Brooklyn, Queens, Bronx, Staten Island
  
  // HPD registration (NYC-specific)
  hpdRegistrationId String?  @map("hpd_registration_id")
  hpdVerifiedAt     DateTime? @map("hpd_verified_at")
  
  // Metadata
  yearBuilt         Int?     @map("year_built")
  totalUnits        Int?     @map("total_units")
  
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  
  // Relations
  landlord          Landlord @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  units             Unit[]
  
  @@index([landlordId])
  @@index([borough])
  @@map("properties")
}

// ============================================================================
// Unit - Individual rental unit (§8)
// ============================================================================

model Unit {
  id                 String     @id @default(cuid())
  propertyId         String     @map("property_id")
  
  // Unit details
  unitNumber         String?    @map("unit_number")
  bedrooms           Int
  bathrooms          Float?
  squareFeet         Int?       @map("square_feet")
  
  // Economics
  askingRentCents    Int        @map("asking_rent_cents")
  utilitiesIncluded  Json?      @map("utilities_included") // {heat, hot_water, electric, gas}
  
  // Availability
  status             UnitStatus @default(DRAFT)
  availableDate      DateTime?  @map("available_date")
  
  // Accessibility (WCAG compliance data - never cut)
  accessibilityFeatures Json?   @map("accessibility_features")
  
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  
  // Relations
  property           Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  cases              Case[]
  fitEvaluations     FitEvaluation[]
  showingSessions ShowingSession[]
  
  @@index([propertyId])
  @@index([bedrooms])
  @@index([status])
  @@index([askingRentCents])
  @@map("units")
}

enum UnitStatus {
  DRAFT
  AVAILABLE
  UNDER_APPLICATION
  LEASED
  OFF_MARKET
}

// ============================================================================
// UtilityAllowanceSchedule - Versioned utility allowance tables (§8)
// ============================================================================

model UtilityAllowanceSchedule {
  id               String   @id @default(cuid())
  orgId            String   @map("org_id")
  
  effectiveFrom    DateTime @map("effective_from")
  effectiveTo      DateTime? @map("effective_to")
  jurisdiction     String   @default("NYC")
  
  // The actual table: {bedrooms: {heat: cents, electric: cents, ...}}
  tableJson        Json     @map("table_json")
  
  sourceDocumentId String?  @map("source_document_id")
  organization     Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  createdAt        DateTime @default(now()) @map("created_at")
  
  @@index([orgId])
  @@index([effectiveFrom])
  @@map("utility_allowance_schedules")
}

// ============================================================================
// Phase 3: Case workflow and objective fit snapshots
// ============================================================================

enum CaseStage {
  INQUIRY
  INTAKE
  VOUCHER_REVIEW
  DOCUMENT_COLLECT
  READY
  MATCHED
  APPLICATION
  PRECLEARANCE
  LEASE_PREP
  LEASE_REVIEW
  INSPECTION
  MOVE_IN_PREP
  PLACED
  INELIGIBLE
  WITHDRAWN
}

model Case {
  id             String @id @default(cuid())
  orgId          String @map("org_id")
  clientId       String @map("client_id")
  ownerUserId    String @map("owner_user_id")
  voucherId      String? @map("voucher_id")
  unitId         String? @map("unit_id")
  stage          CaseStage @default(INQUIRY)
  stageEnteredAt DateTime @default(now()) @map("stage_entered_at")
  stalled        Boolean @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  client         Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  owner          User @relation("CaseOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  voucher        Voucher? @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  unit           Unit? @relation(fields: [unitId], references: [id], onDelete: Restrict)
  history        CaseStageHistory[]
  fitEvaluations FitEvaluation[]
  checklist      ChecklistItem[]
  followUpTasks FollowUpTask[]
  @@index([orgId, stage])
  @@index([orgId, clientId])
  @@index([ownerUserId])
  @@map("cases")
}

model CaseStageHistory {
  id             String @id @default(cuid())
  caseId         String @map("case_id")
  fromStage      CaseStage @map("from_stage")
  toStage        CaseStage @map("to_stage")
  action         String
  actorUserId    String @map("actor_user_id")
  fromOwnerId    String @map("from_owner_id")
  toOwnerId      String @map("to_owner_id")
  reason         String?
  override       Boolean @default(false)
  occurredAt     DateTime @default(now()) @map("occurred_at")
  durationInPrevStageSeconds Int @map("duration_in_prev_stage_seconds")
  case           Case @relation(fields: [caseId], references: [id], onDelete: Restrict)
  actor          User @relation("CaseActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  @@index([caseId, occurredAt])
  @@map("case_stage_history")
}

enum FitResult {
  ELIGIBLE
  INELIGIBLE
  NEEDS_REVIEW
}

model FitEvaluation {
  id                  String @id @default(cuid())
  caseId              String @map("case_id")
  unitId              String @map("unit_id")
  voucherId           String @map("voucher_id")
  result              FitResult
  reasons             Json
  ruleVersion         String @map("rule_version")
  allowanceScheduleId String? @map("allowance_schedule_id")
  snapshot             Json
  computedAt          DateTime @default(now()) @map("computed_at")
  computedBy          String @map("computed_by")
  case                Case @relation(fields: [caseId], references: [id], onDelete: Restrict)
  unit                Unit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  voucher             Voucher @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  @@index([caseId, computedAt])
  @@map("fit_evaluations")
}

enum ChecklistState {
  MISSING
  UPLOADED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
  WAIVED
}

model ChecklistItem {
  id            String @id @default(cuid())
  caseId        String @map("case_id")
  code          String
  blockingStage CaseStage @map("blocking_stage")
  state         ChecklistState @default(MISSING)
  expiresAt     DateTime? @map("expires_at")
  case          Case @relation(fields: [caseId], references: [id], onDelete: Restrict)
  @@unique([caseId, code])
  @@map("checklist_items")
}

// Phase 4: internal scheduling only; no applicant score, ranking or selection.
enum ShowingStatus {
  SCHEDULED
  CANCELLED
}
enum ParticipantStatus {
  INVITED
  CONFIRMED
  DECLINED
  ATTENDED
  NO_SHOW
}
enum FollowUpTaskStatus {
  OPEN
  COMPLETED
}

model ShowingSession {
  id String @id @default(cuid())
  orgId String @map("org_id")
  unitId String @map("unit_id")
  startsAt DateTime @map("starts_at")
  endsAt DateTime @map("ends_at")
  status ShowingStatus @default(SCHEDULED)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  participants ShowingParticipant[]
  events ShowingEvent[]
  tasks FollowUpTask[]
  @@index([orgId, startsAt])
  @@index([unitId, startsAt, endsAt])
  @@map("showing_sessions")
}

model ShowingParticipant {
  id String @id @default(cuid())
  sessionId String @map("session_id")
  clientId String @map("client_id")
  status ParticipantStatus @default(INVITED)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  session ShowingSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  @@unique([sessionId, clientId])
  @@map("showing_participants")
}

model FollowUpTask {
  id String @id @default(cuid())
  orgId String @map("org_id")
  sessionId String? @map("session_id")
  caseId String? @map("case_id")
  ownerUserId String @map("owner_user_id")
  createdById String @map("created_by_id")
  title String
  dueAt DateTime @map("due_at")
  status FollowUpTaskStatus @default(OPEN)
  completedAt DateTime? @map("completed_at")
  createdAt DateTime @default(now()) @map("created_at")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  session ShowingSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  case Case? @relation(fields: [caseId], references: [id], onDelete: Restrict)
  owner User @relation("TaskOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  creator User @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  events ShowingEvent[]
  @@index([orgId, status, dueAt])
  @@map("follow_up_tasks")
}

// Transactional domain history; global audit interceptor is best-effort.
model ShowingEvent {
  id String @id @default(cuid())
  sessionId String? @map("session_id")
  taskId String? @map("task_id")
  actorUserId String @map("actor_user_id")
  action String
  clientId String? @map("client_id")
  fromStatus String? @map("from_status")
  toStatus String? @map("to_status")
  occurredAt DateTime @default(now()) @map("occurred_at")
  session ShowingSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  task FollowUpTask? @relation(fields: [taskId], references: [id], onDelete: Restrict)
  actor User @relation("ShowingEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  @@index([sessionId, occurredAt])
  @@index([taskId, occurredAt])
  @@map("showing_events")
}
